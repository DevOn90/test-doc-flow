#!/usr/bin/env bash

set -euo pipefail

# ----------------------------------------------------
# Verify that core.hooksPath is set to .githooks.
# If not, the hook may have been triggered by accident or 
# the repo is not set up correctly.
# ----------------------------------------------------
HOOKS_PATH="$(git config core.hooksPath 2>/dev/null || true)"
if [[ "${HOOKS_PATH}" != ".githooks" ]]; then
  echo ""
  echo "WARNING: core.hooksPath is not set to '.githooks'."
  echo "This hook may not run automatically on future commits."
  echo "Run the following command in the repository root to fix this:"
  echo ""
  echo "    git config core.hooksPath .githooks"
  echo ""
fi

# ----------------------------------------------------
# Run pre-commit for ODS to CSV conversion  and 
# commit/push the generated CSVs to the repo.
# ----------------------------------------------------

echo "Running pre-commit hook: ODS to CSV conversion"

# Run the ODS to CSV conversion script
python3 scripts/ci/export_ods_to_csv.py

# Stage the generated CSV files for commit
git add -A -- ':(glob)**/exportsCSV/*.csv'

echo "Pre-commit hook completed successfully."